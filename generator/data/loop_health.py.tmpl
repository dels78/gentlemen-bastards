#!/usr/bin/env python3
"""Loop health probe for Herald digests (PERSO-816).

GENERATED by generator/generate.py from generator/data/loop_health.py.tmpl —
do not edit the rendered copy under dist/.

Prints one JSON object on stdout: loop status for the personal triage swarm.
Reuses gate.py's MCP client from the same scripts/ directory on the profile.

MCP contract (dels78/personal-mcp src/tools/artifacts.py ArtifactStore.list_*):
- artifacts_list filters artifact_type and unprocessed_for before limit (see fixtures).
- runs_list returns consolidated runs with role, status, finished_at (status completed on success).
  Herald subject (tool_scopes.json) includes group:artifacts and group:runs.
  Execution: docs/perso-816-loop-health.md (MCP_SERVICE_TOKEN_HERALD, same URL as gate.py).
"""

from __future__ import annotations

import json
import sys
from datetime import datetime, timezone
from pathlib import Path

from gate import GateError, McpClient, extract_items, load_token

COORDINATOR = "coordinator"
STALE_MINUTES = 60


def parse_instant(value: str) -> datetime:
    text = value.strip()
    if text.endswith("Z"):
        text = text[:-1] + "+00:00"
    dt = datetime.fromisoformat(text)
    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=timezone.utc)
    return dt.astimezone(timezone.utc)


def extract_runs(result: dict) -> list:
    """Unwrap a tools/call result to a runs_list payload's runs array."""
    payload = None
    structured = result.get("structuredContent")
    if isinstance(structured, dict):
        payload = structured
    if payload is None or "runs" not in payload:
        for block in result.get("content") or []:
            if isinstance(block, dict) and block.get("type") == "text":
                try:
                    parsed = json.loads(block.get("text") or "")
                except ValueError:
                    continue
                if isinstance(parsed, dict):
                    payload = parsed
                    break
    if payload is None and "runs" in result:
        payload = result
    if not isinstance(payload, dict) or not isinstance(payload.get("runs"), list):
        raise GateError("runs_list result carries no runs list")
    return payload["runs"]


def latest_coordinator_finished_at(runs: list) -> datetime | None:
    best: datetime | None = None
    for run in runs:
        if not isinstance(run, dict):
            continue
        if run.get("role") != COORDINATOR:
            continue
        status = run.get("status")
        if isinstance(status, str) and status.lower() in (
            "failed",
            "error",
            "cancelled",
            "crashed",
        ):
            continue
        for key in ("finished_at", "ended_at", "completed_at"):
            raw = run.get(key)
            if not isinstance(raw, str) or not raw.strip():
                continue
            try:
                finished = parse_instant(raw)
            except ValueError:
                continue
            if best is None or finished > best:
                best = finished
            break
    return best


def oldest_question_created_at(questions: list) -> datetime | None:
    best: datetime | None = None
    for item in questions:
        if not isinstance(item, dict):
            continue
        raw = item.get("created_at")
        if not isinstance(raw, str) or not raw.strip():
            continue
        try:
            created = parse_instant(raw)
        except ValueError:
            continue
        if best is None or created < best:
            best = created
    return best


def coordinator_stale(
    question_count: int,
    last_finished: datetime | None,
    oldest_question_at: datetime | None,
    now: datetime,
) -> bool:
    """Stale when unprocessed Questions aged past STALE_MINUTES with no finish since."""
    if question_count <= 0:
        return False
    if oldest_question_at is not None:
        if (now - oldest_question_at).total_seconds() <= STALE_MINUTES * 60:
            return False
        if last_finished is None:
            return True
        return last_finished < oldest_question_at
    if last_finished is None:
        return True
    return (now - last_finished).total_seconds() > STALE_MINUTES * 60


def main() -> int:
    home = Path(__file__).resolve().parent.parent
    role = home.name
    if role != "herald":
        raise GateError(f"loop_health.py must run under herald profile home, got {role!r}")
    token = load_token(home, role)
    client = McpClient(token)
    client.initialize()

    questions = extract_items(
        client.call_tool(
            "artifacts_list",
            {
                "type": "question",
                "unprocessed_for": COORDINATOR,
                "limit": 500,
            },
        )
    )
    question_count = len(questions)

    runs = extract_runs(
        client.call_tool("runs_list", {"role": COORDINATOR, "limit": 100})
    )
    last_finished = latest_coordinator_finished_at(runs)
    oldest_q = oldest_question_created_at(questions)
    now = datetime.now(timezone.utc)
    stale = coordinator_stale(question_count, last_finished, oldest_q, now)
    status = "degraded" if stale else "ok"
    body: dict = {
        "status": status,
        "unprocessed_questions_for_coordinator": question_count,
    }
    if last_finished is not None:
        body["coordinator_last_finished_at"] = last_finished.isoformat()
    if stale:
        body["alerts"] = [
            {
                "code": "coordinator_stale",
                "message": (
                    "Coordinator has unprocessed Questions but no finished run within "
                    f"{STALE_MINUTES} minutes."
                ),
            }
        ]
    print(json.dumps(body))
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as error:
        print(
            json.dumps(
                {
                    "status": "degraded",
                    "alerts": [
                        {
                            "code": "loop_health_error",
                            "message": str(error),
                        }
                    ],
                }
            )
        )
        print(f"loop_health error: {error}", file=sys.stderr)
        raise SystemExit(1)
