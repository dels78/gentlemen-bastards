{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gentlemen-bastards.example/protocol/consult-response.schema.json",
  "title": "ConsultResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "version", "created_at", "producer", "refs", "payload"],
  "properties": {
    "id": { "type": "string" },
    "type": { "type": "string", "const": "consult-response" },
    "version": { "type": "integer", "const": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "producer": { "type": "string" },
    "refs": {
      "type": "object",
      "additionalProperties": true,
      "required": ["request_id"],
      "properties": {
        "request_id": { "type": "string" }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "required": ["outcome", "answer"],
      "properties": {
        "outcome": {
          "type": "string",
          "enum": ["answered", "escalated", "abort"]
        },
        "answer": { "type": "string" }
      }
    }
  }
}
