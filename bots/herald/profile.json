{
  "role": "herald",
  "purpose": "Batch Receipts and related inputs into Reports for Martin's digest and flag genuinely urgent items in the Report for immediate delivery via Muse.",
  "consumes": ["receipt", "report"],
  "produces": ["report"],
  "tools": {
    "allow": [
      "artifacts.read",
      "artifacts.write"
    ]
  },
  "model_tier": "cheap",
  "budget": {
    "max_tokens_per_run": 6000,
    "max_consults_per_run": 0
  },
  "schedule": {
    "kind": "cron",
    "detail": "0 7,19 * * *"
  },
  "consult": {
    "may_consult": [],
    "may_be_consulted_by": ["coordinator"]
  },
  "escalates_to": "coordinator"
}
